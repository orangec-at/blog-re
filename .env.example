# Contact form → email. Without these two, /contact tells the visitor it is not
# connected and logs the failure. It never pretends the message was delivered.

# Resend API key. https://resend.com → API Keys. Free tier: 3,000/month, 100/day.
RESEND_API_KEY=

# Where inquiries land. Your own inbox.
CONTACT_TO_EMAIL=

# Optional. Defaults to onboarding@resend.dev, which Resend allows without a
# verified domain but only delivers to the Resend account owner's own address.
# Set this to something@<your verified domain> once the domain is verified.
CONTACT_FROM_EMAIL=

# Hosted MCP gateway at /api/mcp. Comma-separated list of API tokens, one per
# caller. Unset means no token is valid and the endpoint answers 401 to
# everything — the correct default, since there is no user store behind it.
# Generate one with: openssl rand -hex 24
MCP_API_TOKENS=

# Optional. Per-token daily call ceiling, best effort only: the counter lives in
# instance memory, so it bounds a runaway client rather than enforcing a quota.
# Defaults to 1000.
MCP_DAILY_QUOTA=
